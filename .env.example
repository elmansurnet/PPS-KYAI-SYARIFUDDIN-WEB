# Nilai bawaan di sini = PRODUKSI (lihat docs/DEPLOY-aapanel.md bagian 3).
# Pengembangan lokal: APP_ENV=local, APP_DEBUG=true, APP_URL=http://localhost:8000,
# SESSION_SECURE_COOKIE=false (tanpa HTTPS cookie Secure tidak dikirim), LOG_LEVEL=debug.
APP_NAME="PPs Kyai Syarifuddin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
# Cadangan "en": kunci terjemahan yang belum ada di lang/id tampil sebagai teks Inggris, bukan kunci mentah.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pps_kyai_syarifuddin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Akun superadmin awal (dibuat oleh RoleSeeder). Isi sendiri; jangan commit nilai sebenarnya.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Cloudflare Turnstile (wajib diisi di production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Kunci HMAC untuk hash NIK (cek duplikat dan pencarian). Buat dengan:
#   php -r "echo bin2hex(random_bytes(32));"
# Minimal 32 byte acak (64 karakter hex); kunci pendek ditolak. Wajib diisi; aplikasi menolak memproses NIK bila kosong. Cadangkan TERPISAH dari APP_KEY dan
# jangan pernah memakai ulang APP_KEY. Bila kunci diganti, jalankan `php artisan pendaftaran:rehash-nik`
# agar cek duplikat dan pencarian NIK kembali akurat.
NIK_HMAC_KEY=

# Cadangan terenkripsi (spatie/laravel-backup). Sandi arsip WAJIB diisi di production; jadwal cadangan menolak berjalan tanpa sandi.
# Buat dengan: php -r "echo bin2hex(random_bytes(24));"
# Simpan TERPISAH dari cadangan dan dari APP_KEY/NIK_HMAC_KEY di luar server (password manager). Lihat docs/DEPLOY-aapanel.md.
BACKUP_ARCHIVE_PASSWORD=
# Opsional: surel untuk kabar cadangan gagal/tidak sehat (butuh MAIL_* yang benar). Kosong = tanpa notifikasi.
BACKUP_NOTIFICATION_EMAIL=
# Folder berisi mysqldump (aaPanel: /www/server/mysql/bin). Kosong = cari di PATH.
DB_DUMP_BINARY_PATH=
